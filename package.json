{
  "name": "@threepipe/arrangement-2d-js",
  "version": "1.0.0",
  "description": "CGAL 2D Arrangements compiled to WebAssembly (from LokiResearch/arrangement-2d-js), published for @threepipe/plugin-svg-renderer",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repalash/arrangement-2d-js.git"
  },
  "homepage": "https://github.com/repalash/arrangement-2d-js#readme",
  "type": "module",
  "author": {
    "name": "Axel Antoine",
    "email": "ax.antoine@gmail.com",
    "url": "https://axantoine.com"
  },
  "main": "build/Arrangement2D.umd.js",
  "module": "build/Arrangement2D.esm.js",
  "types": "build/Arrangement2D.esm.d.ts",
  "files": [
    "build/Arrangement2D.esm.js",
